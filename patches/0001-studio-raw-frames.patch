From c7a7724d5d6ed39aebff5655cc28f3198cd267cf Mon Sep 17 00:00:00 2001
From: Rigoberto Leyva Salmeron <61335136+rleyvasal@users.noreply.github.com>
Date: Thu, 15 Oct 2026 08:30:00 -0700
Subject: [PATCH] feat(studio): Add raw frames alongside Studio RPC messages

Let modules exchange small non-protobuf frames over the Studio transport,
so features like a live log can reuse the connection the configurator
already has open instead of needing a second serial port.

A raw frame uses the normal Studio framing, with a one-byte prefix whose
protobuf wire type (3, 4, 6 or 7) proto3 never emits, so it can't be
mistaken for a Request or Response. Host-to-device frames go to handlers
registered with ZMK_RPC_RAW_FRAME_HANDLER and get no RPC response.
zmk_rpc_send_raw_frame() sends device-to-host frames without blocking.

Also stop the UART transport from spinning in its TX interrupt when the
host isn't reading, and fix send_response() returning with the transport
mutex held when encoding fails.
---
 .../linker/zmk-rpc-raw-frame-handlers.ld      |   9 ++
 app/include/zmk/studio/rpc.h                  |  48 ++++++++
 app/src/studio/CMakeLists.txt                 |   1 +
 app/src/studio/rpc.c                          | 113 +++++++++++++++++-
 app/src/studio/uart_rpc_transport.c           |  14 ++-
 5 files changed, 179 insertions(+), 6 deletions(-)
 create mode 100644 app/include/linker/zmk-rpc-raw-frame-handlers.ld

diff --git a/app/include/linker/zmk-rpc-raw-frame-handlers.ld b/app/include/linker/zmk-rpc-raw-frame-handlers.ld
new file mode 100644
index 00000000..beecf9e5
--- /dev/null
+++ b/app/include/linker/zmk-rpc-raw-frame-handlers.ld
@@ -0,0 +1,9 @@
+/*
+ * Copyright (c) 2026 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <zephyr/linker/linker-defs.h>
+
+ITERABLE_SECTION_ROM(zmk_rpc_raw_frame_handler, 4)
diff --git a/app/include/zmk/studio/rpc.h b/app/include/zmk/studio/rpc.h
index e223b7a5..60ddb8b8 100644
--- a/app/include/zmk/studio/rpc.h
+++ b/app/include/zmk/studio/rpc.h
@@ -219,6 +219,54 @@ struct ring_buf *zmk_rpc_get_tx_buf(void);
 struct ring_buf *zmk_rpc_get_rx_buf(void);
 void zmk_rpc_rx_notify(void);
 
+/**
+ * @brief Raw frames share the Studio framing (SOF/ESC/EOF) with protobuf RPC messages, but carry
+ *        an application payload whose first byte is a one-byte prefix instead of a protobuf tag.
+ *
+ * A prefix is only valid if it can never start an encoded zmk_studio_Request/Response: its low
+ * three bits (the protobuf wire type) must be 3, 4, 6 or 7, which proto3 never emits. Examples:
+ * 'C' (0x43), 'D' (0x44), 'G' (0x47), 'K' (0x4B), 'L' (0x4C).
+ */
+#define ZMK_RPC_RAW_FRAME_PREFIX_VALID(p)                                                          \
+    (((p) & 0x07) == 3 || ((p) & 0x07) == 4 || ((p) & 0x07) == 6 || ((p) & 0x07) == 7)
+
+/** Largest raw frame payload (prefix included) delivered to a raw frame handler. */
+#define ZMK_RPC_RAW_FRAME_RX_MAX 32
+
+typedef void (*zmk_rpc_raw_frame_handler_func)(const uint8_t *payload, size_t len);
+
+struct zmk_rpc_raw_frame_handler {
+    uint8_t prefix;
+    zmk_rpc_raw_frame_handler_func func;
+};
+
+/**
+ * @brief Register a handler for host-to-device raw frames whose first payload byte is `_prefix`.
+ *        The handler runs on the Studio RPC thread and receives the whole payload, prefix
+ *        included, truncated to ZMK_RPC_RAW_FRAME_RX_MAX bytes. Such frames never reach the
+ *        protobuf decoder and get no RPC response.
+ */
+#define ZMK_RPC_RAW_FRAME_HANDLER(name, _prefix, _func)                                            \
+    BUILD_ASSERT(ZMK_RPC_RAW_FRAME_PREFIX_VALID(_prefix),                                          \
+                 "Raw frame prefix would collide with a protobuf field tag");                      \
+    STRUCT_SECTION_ITERABLE(zmk_rpc_raw_frame_handler, name) = {                                   \
+        .prefix = _prefix,                                                                         \
+        .func = _func,                                                                             \
+    }
+
+/**
+ * @brief Send one device-to-host raw frame on the selected Studio transport.
+ *
+ * Never blocks: if another sender holds the transport, or the whole escaped frame does not fit in
+ * the TX buffer, nothing is written and -EAGAIN is returned. Callers that can lose data (logs)
+ * should simply drop it; it is safe to call from a work queue.
+ *
+ * @param payload Payload bytes; payload[0] must satisfy ZMK_RPC_RAW_FRAME_PREFIX_VALID.
+ * @param len Payload length, including the prefix byte.
+ * @retval 0 on success, -EINVAL, -ENOTCONN (no transport), -EMSGSIZE or -EAGAIN otherwise.
+ */
+int zmk_rpc_send_raw_frame(const uint8_t *payload, size_t len);
+
 #define ZMK_RPC_TRANSPORT(name, _transport, _rx_start, _rx_stop, _tx_user_data, _tx_notify)        \
     STRUCT_SECTION_ITERABLE(zmk_rpc_transport, name) = {                                           \
         .transport = _transport,                                                                   \
diff --git a/app/src/studio/CMakeLists.txt b/app/src/studio/CMakeLists.txt
index a8417dd7..886b9ba2 100644
--- a/app/src/studio/CMakeLists.txt
+++ b/app/src/studio/CMakeLists.txt
@@ -6,6 +6,7 @@ zephyr_linker_sources(SECTIONS ../../include/linker/zmk-rpc-subsystem-handlers.l
 zephyr_linker_sources(SECTIONS ../../include/linker/zmk-rpc-subsystem-settings-reset.ld)
 zephyr_linker_sources(SECTIONS ../../include/linker/zmk-rpc-event-mappers.ld)
 zephyr_linker_sources(SECTIONS ../../include/linker/zmk-rpc-transport.ld)
+zephyr_linker_sources(SECTIONS ../../include/linker/zmk-rpc-raw-frame-handlers.ld)
 
 target_sources(app PRIVATE msg_framing.c)
 target_sources(app PRIVATE rpc.c)
diff --git a/app/src/studio/rpc.c b/app/src/studio/rpc.c
index e79b5568..df935d65 100644
--- a/app/src/studio/rpc.c
+++ b/app/src/studio/rpc.c
@@ -82,6 +82,33 @@ struct ring_buf *zmk_rpc_get_rx_buf(void) { return &rpc_rx_buf; }
 
 void zmk_rpc_rx_notify(void) { k_sem_give(&rpc_rx_sem); }
 
+/* Host-to-device raw frame state. A frame is raw when its first payload byte is a registered
+ * prefix; its bytes are collected here instead of being handed to the protobuf decoder. */
+static bool rpc_frame_started;
+static bool rpc_raw_frame;
+static uint8_t rpc_raw_buf[ZMK_RPC_RAW_FRAME_RX_MAX];
+static size_t rpc_raw_len;
+
+static bool is_raw_frame_prefix(uint8_t b) {
+    if (!ZMK_RPC_RAW_FRAME_PREFIX_VALID(b)) {
+        return false;
+    }
+    STRUCT_SECTION_FOREACH(zmk_rpc_raw_frame_handler, handler) {
+        if (handler->prefix == b) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void dispatch_raw_frame(void) {
+    STRUCT_SECTION_FOREACH(zmk_rpc_raw_frame_handler, handler) {
+        if (handler->prefix == rpc_raw_buf[0]) {
+            handler->func(rpc_raw_buf, rpc_raw_len);
+        }
+    }
+}
+
 static bool rpc_read_cb(pb_istream_t *stream, uint8_t *buf, size_t count) {
     uint32_t write_offset = 0;
 
@@ -92,7 +119,18 @@ static bool rpc_read_cb(pb_istream_t *stream, uint8_t *buf, size_t count) {
         if (len > 0) {
             for (int i = 0; i < len; i++) {
                 if (studio_framing_process_byte(&rpc_framing_state, buffer[i])) {
-                    buf[write_offset++] = buffer[i];
+                    if (!rpc_frame_started) {
+                        rpc_frame_started = true;
+                        rpc_raw_frame = is_raw_frame_prefix(buffer[i]);
+                        rpc_raw_len = 0;
+                    }
+                    if (rpc_raw_frame) {
+                        if (rpc_raw_len < sizeof(rpc_raw_buf)) {
+                            rpc_raw_buf[rpc_raw_len++] = buffer[i];
+                        }
+                    } else {
+                        buf[write_offset++] = buffer[i];
+                    }
                 }
             }
         } else {
@@ -177,6 +215,8 @@ static pb_ostream_t pb_ostream_for_tx_buf(void *user_data) {
 }
 
 static int send_response(const zmk_studio_Response *resp) {
+    int ret = 0;
+
     k_mutex_lock(&rpc_transport_mutex, K_FOREVER);
 
     if (!selected_transport) {
@@ -199,7 +239,8 @@ static int send_response(const zmk_studio_Response *resp) {
 #if !IS_ENABLED(CONFIG_NANOPB_NO_ERRMSG)
         LOG_ERR("Failed to encode the message %s", stream.errmsg);
 #endif // !IS_ENABLED(CONFIG_NANOPB_NO_ERRMSG)
-        return -EINVAL;
+        ret = -EINVAL;
+        goto exit;
     }
 
     framing_byte = FRAMING_EOF;
@@ -209,7 +250,67 @@ static int send_response(const zmk_studio_Response *resp) {
 
 exit:
     k_mutex_unlock(&rpc_transport_mutex);
-    return 0;
+    return ret;
+}
+
+static bool needs_escape(uint8_t b) {
+    return b == FRAMING_SOF || b == FRAMING_ESC || b == FRAMING_EOF;
+}
+
+int zmk_rpc_send_raw_frame(const uint8_t *payload, size_t len) {
+    int ret = 0;
+
+    if (!payload || len == 0 || !ZMK_RPC_RAW_FRAME_PREFIX_VALID(payload[0])) {
+        return -EINVAL;
+    }
+
+    /* Raw frames are best-effort side traffic; never wait behind an RPC response. */
+    if (k_mutex_lock(&rpc_transport_mutex, K_NO_WAIT) != 0) {
+        return -EAGAIN;
+    }
+
+    if (!selected_transport) {
+        ret = -ENOTCONN;
+        goto exit_raw;
+    }
+
+    size_t frame_len = len + 2;
+    for (size_t i = 0; i < len; i++) {
+        if (needs_escape(payload[i])) {
+            frame_len++;
+        }
+    }
+
+    if (frame_len > ring_buf_capacity_get(&rpc_tx_buf)) {
+        ret = -EMSGSIZE;
+        goto exit_raw;
+    }
+
+    /* All producers hold the mutex and the transport only frees space, so a frame that fits now
+     * is written whole and never interleaves with an RPC response. */
+    if (frame_len > ring_buf_space_get(&rpc_tx_buf)) {
+        ret = -EAGAIN;
+        goto exit_raw;
+    }
+
+    uint8_t framing_byte = FRAMING_SOF;
+    ring_buf_put(&rpc_tx_buf, &framing_byte, 1);
+    for (size_t i = 0; i < len; i++) {
+        if (needs_escape(payload[i])) {
+            framing_byte = FRAMING_ESC;
+            ring_buf_put(&rpc_tx_buf, &framing_byte, 1);
+        }
+        ring_buf_put(&rpc_tx_buf, &payload[i], 1);
+    }
+    framing_byte = FRAMING_EOF;
+    ring_buf_put(&rpc_tx_buf, &framing_byte, 1);
+
+    void *user_data = selected_transport->tx_user_data ? selected_transport->tx_user_data() : NULL;
+    selected_transport->tx_notify(&rpc_tx_buf, frame_len, true, user_data);
+
+exit_raw:
+    k_mutex_unlock(&rpc_transport_mutex);
+    return ret;
 }
 
 static void rpc_main(void) {
@@ -222,8 +323,12 @@ static void rpc_main(void) {
         bool status = pb_decode(&stream, &zmk_studio_Request_msg, &req);
 
         rpc_framing_state = FRAMING_STATE_IDLE;
+        rpc_frame_started = false;
 
-        if (status) {
+        if (rpc_raw_frame) {
+            rpc_raw_frame = false;
+            dispatch_raw_frame();
+        } else if (status) {
             zmk_studio_Response resp = handle_request(&req);
 
             int err = send_response(&resp);
diff --git a/app/src/studio/uart_rpc_transport.c b/app/src/studio/uart_rpc_transport.c
index 6dcac6d1..4141c09b 100644
--- a/app/src/studio/uart_rpc_transport.c
+++ b/app/src/studio/uart_rpc_transport.c
@@ -130,12 +130,22 @@ static void serial_cb(const struct device *dev, void *user_data) {
             uint32_t claim_len = ring_buf_get_claim(tx_buf, &buf, tx_buf->size);
 
             if (claim_len == 0) {
-                continue;
+                break;
             }
 
             int sent = uart_fifo_fill(uart_dev, buf, claim_len);
 
-            ring_buf_get_finish(tx_buf, MAX(sent, 0));
+            if (sent <= 0) {
+                /* The host isn't draining the port; retry on the next TX-ready interrupt. */
+                ring_buf_get_finish(tx_buf, 0);
+                break;
+            }
+
+            ring_buf_get_finish(tx_buf, sent);
+        }
+
+        if (ring_buf_is_empty(tx_buf)) {
+            uart_irq_tx_disable(uart_dev);
         }
     }
 }
